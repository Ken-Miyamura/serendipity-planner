    "「%@」の天気情報が見つかりません。都市名を確認してください。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の天気情報が見つかりません。都市名を確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No weather found for “%@”. Check the city name."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’의 날씨를 찾을 수 없어요. 도시 이름을 확인해 주세요."
          }
        }
      }
    },
    "あなたの現在地に合わせて\n最適なプランを提案します": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの現在地に合わせて\n最適なプランを提案します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas that suit\nwherever you happen to be."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 있는 곳에 맞는\n추천을 찾아 드려요."
          }
        }
      }
    },
    "あなたの現在地に応じた提案": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの現在地に応じた提案"
