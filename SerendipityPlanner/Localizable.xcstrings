        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@. A browse could be a nice change."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 구경하며 기분 전환해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Dar una vuelta por las tiendas despeja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Une virée boutiques, ça change les idées."
          }
        }
      }
    },
    "%@。テラス席も気持ちよさそうです。": {
      "extractionState": "extracted_with_value",
