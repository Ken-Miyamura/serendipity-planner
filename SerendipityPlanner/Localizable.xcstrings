    "予定を確認して空き時間を自動で検出し、\nあなたに合った体験を提案します": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を確認して空き時間を自動で検出し、\nあなたに合った体験を提案します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We read your schedule to spot the gaps,\nthen suggest something that fits."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정을 보고 틈을 찾아서\n거기에 맞는 걸 추천해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leemos tu agenda para ver los huecos\ny sugerir algo que encaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On lit ton agenda pour repérer les creux,\npuis on propose quelque chose qui colle."
          }
        }
      }
    },
    "今いる場所から、すきま時間に": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今いる場所から、すきま時間に"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near you, in the gaps"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 이곳에서, 틈새 시간에"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de ti, en los huecos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Près de toi, dans les creux"
          }
        }
      }
    },
    "今日": {
      "extractionState": "extracted_with_value",
