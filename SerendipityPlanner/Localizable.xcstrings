  "strings": {
    " 周辺から提案中": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 周辺から提案中"
          }
        }
      }
    },
    "%@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@(%@)": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(%@)"
          }
        }
      }
    },
    "%@、%@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、%@"
          }
        }
      }
    },
    "%@、%@、%@に追加": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、%@、%@に追加"
          }
        }
      }
    },
    "%@、%lld回": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、%lld回"
          }
        }
      }
    },
    "%@、%lld回選択": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、%lld回選択"
          }
        }
      }
    },
    "%@。お出かけ日和、ショッピングを楽しんで。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。お出かけ日和、ショッピングを楽しんで。"
          }
        }
      }
    },
    "%@。お散歩日和です！": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。お散歩日和です！"
          }
        }
      }
    },
    "%@。アートに触れてみませんか。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。アートに触れてみませんか。"
          }
        }
      }
    },
    "%@。アートに触れてインスピレーションを。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。アートに触れてインスピレーションを。"
          }
        }
      }
    },
    "%@。カフェでほっとひと息つきましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。カフェでほっとひと息つきましょう。"
          }
        }
      }
    },
    "%@。グルメを楽しみましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。グルメを楽しみましょう。"
          }
        }
      }
    },
    "%@。ショッピングで気分転換を。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。ショッピングで気分転換を。"
          }
        }
      }
    },
    "%@。テラス席も気持ちよさそうです。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。テラス席も気持ちよさそうです。"
          }
        }
      }
    },
    "%@。リラックスタイムを楽しんで。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。リラックスタイムを楽しんで。"
          }
        }
      }
    },
    "%@。体を動かすのに気持ちいい天気です！": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。体を動かすのに気持ちいい天気です！"
          }
        }
      }
    },
    "%@。映画を観てリフレッシュ。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。映画を観てリフレッシュ。"
          }
        }
      }
    },
    "%@。映画館で素敵な作品に出会いましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。映画館で素敵な作品に出会いましょう。"
          }
        }
      }
    },
    "%@。気分転換に歩いてみましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。気分転換に歩いてみましょう。"
          }
        }
      }
    },
    "%@。美味しいものを食べに出かけましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。美味しいものを食べに出かけましょう。"
          }
        }
      }
    },
    "%@。自然の中でリラックスしましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。自然の中でリラックスしましょう。"
          }
        }
      }
    },
    "%@。読書にぴったりの天気です。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。読書にぴったりの天気です。"
          }
        }
      }
    },
    "%@。運動でリフレッシュしましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。運動でリフレッシュしましょう。"
          }
        }
      }
    },
    "%@。音楽で気分を上げましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。音楽で気分を上げましょう。"
          }
        }
      }
    },
    "%@。音楽を楽しむのにいい日ですね。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。音楽を楽しむのにいい日ですね。"
          }
        }
      }
    },
    "%@から%@ ・ %@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から%@ ・ %@"
          }
        }
      }
    },
    "%@で%@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で%@"
          }
        }
      }
    },
    "%@ですが、少しの時間なら大丈夫。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ですが、少しの時間なら大丈夫。"
          }
        }
      }
    },
    "%@で過ごす、すきま時間": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で過ごす、すきま時間"
          }
        }
      }
    },
    "%@に空き時間があります。%@はいかがですか？": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に空き時間があります。%@はいかがですか？"
          }
        }
      }
    },
    "%@の ほかの候補": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の ほかの候補"
          }
        }
      }
    },
    "%@の日こそ、映画館でゆっくり過ごしましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の日こそ、映画館でゆっくり過ごしましょう。"
          }
        }
      }
    },
    "%@の日こそ、美術館でゆっくり過ごしましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の日こそ、美術館でゆっくり過ごしましょう。"
          }
        }
      }
    },
    "%@の日は、あったかいお店で美味しいものを。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の日は、あったかいお店で美味しいものを。"
          }
        }
      }
    },
    "%@の日は、室内で体を動かしましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の日は、室内で体を動かしましょう。"
          }
        }
      }
    },
    "%@の日は、屋内でショッピングを楽しみましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の日は、屋内でショッピングを楽しみましょう。"
          }
        }
      }
    },
    "%@の日は、温かいカフェでゆっくりしましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の日は、温かいカフェでゆっくりしましょう。"
          }
        }
      }
    },
    "%@の日は、静かな場所で心を落ち着けましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の日は、静かな場所で心を落ち着けましょう。"
          }
        }
      }
    },
    "%@の日は、音楽に浸って過ごしましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の日は、音楽に浸って過ごしましょう。"
          }
        }
      }
    },
