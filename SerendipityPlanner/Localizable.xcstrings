        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 느긋한 시간을 보내 봐요."
          }
        }
      }
    },
    "%@。体を動かすのに気持ちいい天気です！": {
      "extractionState": "extracted_with_value",
