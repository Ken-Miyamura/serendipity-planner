            "state": "translated",
            "value": "It's %@. A good meal sounds right."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 맛있는 한 끼 어때요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Una buena comida apetece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Un bon repas, ça tombe bien."
          }
        }
      }
    },
    "%@。ショッピングで気分転換を。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。ショッピングで気分転換を。"
