        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 영화 한 편으로 리프레시."
          }
        }
      }
    },
    "%@。映画館で素敵な作品に出会いましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
