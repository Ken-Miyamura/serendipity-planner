    "静かな場所で瞑想の時間を。呼吸に集中して、心をクリアにしましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かな場所で瞑想の時間を。呼吸に集中して、心をクリアにしましょう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find somewhere quiet and just breathe. Ten minutes is enough to clear things."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용한 곳에서 그냥 숨만 쉬어 봐요. 십 분이면 충분해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca un sitio tranquilo y respira. Diez minutos bastan para aclarar las cosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve un endroit calme et respire, simplement. Dix minutes suffisent à y voir clair."
          }
        }
      }
    },
