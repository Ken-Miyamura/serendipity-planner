    "頑張った自分へのご褒美に、美味しいスイーツとコーヒーはいかがですか？": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頑張った自分へのご褒美に、美味しいスイーツとコーヒーはいかがですか？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've earned it. Why not a good coffee and something sweet?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 애쓴 나에게. 맛있는 디저트와 커피 어때요?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te lo has ganado. ¿Un buen café y algo dulce?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu l'as bien mérité. Et si c'était un bon café avec une pâtisserie ?"
          }
        }
      }
    },
