        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@. A café could be a nice pause."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 카페에서 잠시 쉬어 가요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Un café puede venir bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Un café, le temps de souffler."
          }
        }
      }
    },
    "%@。グルメを楽しみましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
