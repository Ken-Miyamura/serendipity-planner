        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A suggestion arrives\njust before your free time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 시간이 시작되기 전에\n추천이 도착해요."
          }
        },
        "es": {
          "stringUnit": {
