    "%@。お出かけ日和、ショッピングを楽しんで。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。お出かけ日和、ショッピングを楽しんで。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@ — a good day to be out and browse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 나들이하기 좋은 날, 구경하며 걸어 봐요."
          }
        }
      }
    },
    "%@。お散歩日和です！": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。お散歩日和です！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@ — good weather for a walk."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 산책하기 좋은 날이에요."
          }
        }
      }
    },
    "%@。アートに触れてみませんか。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。アートに触れてみませんか。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@. Why not see some art?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 예술을 만나 보는 건 어때요?"
          }
        }
      }
    },
    "%@。アートに触れてインスピレーションを。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。アートに触れてインスピレーションを。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@ — art might spark something."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 예술에서 영감을 얻어 봐요."
          }
        }
      }
    },
    "%@。カフェでほっとひと息つきましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。カフェでほっとひと息つきましょう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@. A café could be a nice pause."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 카페에서 잠시 쉬어 가요."
          }
        }
      }
    },
    "%@。グルメを楽しみましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。グルメを楽しみましょう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@. A good meal sounds right."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 맛있는 한 끼 어때요."
          }
        }
      }
    },
    "%@。ショッピングで気分転換を。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。ショッピングで気分転換を。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@. A browse could be a nice change."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 구경하며 기분 전환해요."
          }
        }
      }
    },
    "%@。テラス席も気持ちよさそうです。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。テラス席も気持ちよさそうです。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@ — a terrace seat sounds nice."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 테라스 자리도 좋을 것 같아요."
          }
        }
      }
    },
    "%@。リラックスタイムを楽しんで。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
