    "美術館でじっくりアートに浸りましょう。心が豊かになる時間です。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "美術館でじっくりアートに浸りましょう。心が豊かになる時間です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give a few rooms your full attention. It's a good way to spend an hour."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 개의 방만 천천히 봐도 좋아요. 시간을 잘 쓴 기분이 들어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica toda tu atención a unas pocas salas. Es una buena forma de pasar una hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consacre toute ton attention à quelques salles. C'est une bonne façon de passer une heure."
