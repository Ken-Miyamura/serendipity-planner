            "value": "End"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료"
          }
        }
      }
    },
    "美術館でじっくりアートに浸りましょう。心が豊かになる時間です。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "美術館でじっくりアートに浸りましょう。心が豊かになる時間です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give a few rooms your full attention. It's a good way to spend an hour."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 개의 방만 천천히 봐도 좋아요. 시간을 잘 쓴 기분이 들어요."
          }
        }
      }
    },
    "美術館でアート体験": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "美術館でアート体験"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An hour at a museum"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미술관에서 한 시간"
          }
        }
      }
    },
    "興味のあるジャンル": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "興味のあるジャンル"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you're into"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관심 있는 것"
          }
        }
      }
    },
    "行き先を選ぶと、その街での小さな偶然をご提案します": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行き先を選ぶと、その街での小さな偶然をご提案します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where you're headed and we'll find small surprises there"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갈 곳을 고르면 그 동네의 작은 우연을 찾아 드려요"
          }
        }
      }
    },
    "街を歩きながら、美味しいものを食べ歩き。小さな幸せを見つけましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "街を歩きながら、美味しいものを食べ歩き。小さな幸せを見つけましょう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through a few small places on foot. Little finds, one bite at a time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸으면서 작은 가게 몇 곳을 들러 봐요. 한 입씩 남는 즐거움이 있어요."
          }
        }
      }
    },
    "街中のパブリックアートやストリートアートを探してみませんか。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
