    "次の空き時間とおすすめのアクティビティを表示します": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の空き時間とおすすめのアクティビティを表示します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your next free slot and an idea for it"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 여유 시간과 추천을 보여줘요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tu próximo hueco y una idea para él"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ton prochain creux et une idée pour l'occuper"
          }
        }
      }
    },
    "毎朝、今日の隙間時間の数をお知らせします。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎朝、今日の隙間時間の数をお知らせします。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each morning, a note on how much free time you have."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침마다 오늘 여유 시간이 얼마나 있는지 알려 드려요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mañana, cuánto rato libre tienes hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque matin, un mot sur le temps libre que tu as."
          }
        }
      }
    },
    "気になっていたお店に行ってみましょう。新しい味との出会いが待っています。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気になっていたお店に行ってみましょう。新しい味との出会いが待っています。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That place you keep walking past. Today's as good a day as any."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지나치기만 했던 그 가게. 오늘이 가 볼 만한 날이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese sitio por el que pasas siempre. Hoy es tan buen día como otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse devant laquelle tu passes toujours. Aujourd'hui vaut bien un autre jour."
          }
        }
      }
    },
    "気になっていた記事や雑誌を読む時間に。新しい知識やインスピレーションを得ましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気になっていた記事や雑誌を読む時間に。新しい知識やインスピレーションを得ましょう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time for the article you've been meaning to read. Something new might stick."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미뤄 둔 글을 읽을 시간. 새로 남는 것이 있을지도 몰라요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El artículo que llevas tiempo posponiendo. Igual se te queda algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'article que tu repousses depuis un moment. Il en restera peut-être quelque chose."
          }
        }
      }
    },
    "気ままにショッピングを楽しみましょう。トレンドチェックにもぴったり。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気ままにショッピングを楽しみましょう。トレンドチェックにもぴったり。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse with nothing in particular in mind. Good for seeing what's around."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "딱히 살 것 없이 둘러봐요. 요즘 뭐가 있는지 보기에도 좋아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Date una vuelta sin nada concreto en mente. Va bien para ver qué hay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flâne sans rien chercher de précis. Pratique pour voir ce qui se fait."
          }
        }
      }
    },
    "気分転換に外を歩きましょう。いつもと違う道を通ると、新しい発見があるかもしれません。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気分転換に外を歩きましょう。いつもと違う道を通ると、新しい発見があるかもしれません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step outside for a bit. Take a street you don't usually take and see what turns up."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠깐 밖을 걸어 봐요. 늘 가던 길 말고 다른 골목으로 들어서면 뜻밖의 것이 보이기도 해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal a caminar un rato. Coge una calle por la que no sueles pasar y mira qué aparece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sors marcher un peu. Prends une rue que tu ne prends jamais, tu verras ce qui apparaît."
          }
        }
      }
    },
    "温かい飲み物を片手に、ゆったりとした時間を過ごしましょう。新しいカフェを開拓するのも良いですね。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温かい飲み物を片手に、ゆったりとした時間を過ごしましょう。新しいカフェを開拓するのも良いですね。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take it slow with something warm in hand. Trying a café you've never been to is half the fun."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻한 음료 한 잔과 함께 느긋한 시간을. 안 가 본 카페를 찾아보는 것도 좋아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con algo caliente en la mano y sin prisa. Probar un café nuevo es parte de la gracia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose de chaud à la main, sans se presser. Tester un café inconnu fait partie du plaisir."
          }
        }
      }
    },
