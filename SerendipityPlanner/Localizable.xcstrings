        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 몸을 움직이기 좋은 날씨예요."
          }
        }
      }
    },
    "%@。映画を観てリフレッシュ。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
