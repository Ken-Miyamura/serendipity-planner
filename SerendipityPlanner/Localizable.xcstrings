        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 시간을 다시 찾아요"
          }
        }
      }
    },
    "空き時間の前に\n体験の提案を通知します": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
