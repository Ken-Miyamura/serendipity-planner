    "「%@」の天気情報が見つかりません。都市名を確認してください。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の天気情報が見つかりません。都市名を確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No weather found for “%@”. Check the city name."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’의 날씨를 찾을 수 없어요. 도시 이름을 확인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay datos del tiempo para «%@». Revisa el nombre de la ciudad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune météo trouvée pour « %@ ». Vérifie le nom de la ville."
          }
        }
      }
    },
    "あなたの現在地に合わせて\n最適なプランを提案します": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの現在地に合わせて\n最適なプランを提案します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas that suit\nwherever you happen to be."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 있는 곳에 맞는\n추천을 찾아 드려요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas que encajan\ncon donde estés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des idées adaptées\nà l'endroit où tu te trouves."
          }
        }
      }
    },
    "あなたの現在地に応じた提案": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの現在地に応じた提案"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on where you are"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 있는 곳에 맞춰서"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según dónde estés"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon l'endroit où tu es"
          }
        }
      }
    },
    "あなた好みの体験を学習": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた好みの体験を学習"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learns what you like"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취향을 익혀 가요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende lo que te gusta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprend ce que tu aimes"
          }
        }
      }
    },
    "いつもと違うお店でランチタイム。美味しいご飯で午後も頑張れます。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつもと違うお店でランチタイム。美味しいご飯で午後も頑張れます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch away from the usual spot. The afternoon tends to go better for it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "늘 가던 곳 말고 다른 데서 점심을. 오후가 좀 더 수월해져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Come fuera del sitio de siempre. La tarde suele ir mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjeune ailleurs que d'habitude. L'après-midi passe souvent mieux."
          }
        }
      }
    },
    "いつもの何気ない空き時間を、\n偶然出会う楽しみのきっかけに。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつもの何気ない空き時間を、\n偶然出会う楽しみのきっかけに。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the odd empty half hour\ninto something worth remembering."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그냥 비어 있던 삼십 분을\n기억에 남는 시간으로."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte esa media hora vacía\nen algo que merezca recordarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme cette demi-heure vide\nen quelque chose dont on se souvient."
          }
        }
      }
    },
    "おつかれさまでした。\n明日も素敵な一日になりますように": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おつかれさまでした。\n明日も素敵な一日になりますように"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's the day done.\nHere's to a good one tomorrow"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 하루 수고했어요.\n내일도 좋은 하루이기를"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Día terminado.\nQue mañana sea uno bueno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La journée est finie.\nQue demain soit aussi une belle journée"
          }
        }
      }
    },
    "おはようございます ☀️": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おはようございます ☀️"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good morning ☀️"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 아침이에요 ☀️"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buenos días ☀️"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour ☀️"
          }
        }
      }
    },
    "おはようございます。\n今日、素敵な偶然が訪れますように": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おはようございます。\n今日、素敵な偶然が訪れますように"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good morning.\nHere's to a happy accident today"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 아침이에요.\n오늘 좋은 우연이 있기를"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buenos días.\nQue hoy te pase algo bueno por casualidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour.\nQu'un beau hasard croise ta route aujourd'hui"
          }
        }
      }
    },
    "お寺で静かなひととき": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お寺で静かなひととき"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet corner"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용한 자리 하나"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rincón tranquilo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coin tranquille"
          }
        }
      }
    },
    "お寺や神社で心を静めましょう。日常から離れて、穏やかな時間を。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お寺や神社で心を静めましょう。日常から離れて、穏やかな時間を。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somewhere still, away from the day. A garden or a quiet courtyard will do."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에서 한 발 떨어진 곳으로. 절이나 고궁 정원이면 충분해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sitio en calma, lejos del día. Un jardín o el claustro de una iglesia sirven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un endroit calme, à l'écart de la journée. Un jardin ou le cloître d'une église suffit."
          }
        }
      }
    },
    "お気に入り": {
      "extractionState": "extracted_with_value",
