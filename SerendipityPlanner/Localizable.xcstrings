    "レコードショップで新しい音楽を発掘。思わぬ名盤に出会えるかも。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レコードショップで新しい音楽を発掘。思わぬ名盤に出会えるかも。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dig through the crates. The record you didn't know you wanted is in there somewhere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레코드를 한 장씩 넘기다 보면, 몰랐던 명반을 만나기도 해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebusca entre los cajones. El disco que no sabías que querías anda por ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fouille dans les bacs. Le disque que tu ne savais pas vouloir est quelque part là-dedans."
          }
        }
      }
    },
