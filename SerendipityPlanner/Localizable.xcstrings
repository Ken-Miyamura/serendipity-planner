      }
    },
    "今日の残り時間に、\n小さな幸運を見つけましょう": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の残り時間に、\n小さな幸運を見つけましょう"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's still time today\nfor a bit of luck"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 오늘 안에\n작은 행운 하나 찾아봐요"
          }
        },
        "es": {
          "stringUnit": {
