    "お気に入りに保存したすべての提案が削除されます。この操作は取り消せません。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに保存したすべての提案が削除されます。この操作は取り消せません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All saved suggestions will be deleted. This can't be undone."
          }
        },
        "ko": {
