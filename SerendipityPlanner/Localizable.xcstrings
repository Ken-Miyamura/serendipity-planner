    "ミニシアターで隠れた名作に出会いましょう。新しい映画体験が待っています。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミニシアターで隠れた名作に出会いましょう。新しい映画体験が待っています。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small screens keep the good ones alive. Something unexpected is usually showing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 극장이 좋은 영화를 오래 걸어 둬요. 예상 밖의 작품을 만나기도 해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las salas pequeñas mantienen vivas las buenas. Casi siempre hay algo inesperado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les petites salles gardent les bons films à l'affiche. Il y a presque toujours une surprise."
          }
        }
      }
    },
    "ヨガでリラックス": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
