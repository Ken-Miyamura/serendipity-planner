    "今日、素敵な偶然が訪れますように": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日、素敵な偶然が訪れますように"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here's to a happy accident today"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 좋은 우연이 있기를"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que hoy te pase algo bueno por casualidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'un beau hasard croise ta route aujourd'hui"
          }
        }
      }
    },
    "今日の予定": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
