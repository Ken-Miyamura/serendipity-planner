    "お気に入りに保存したすべての提案が削除されます。この操作は取り消せません。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに保存したすべての提案が削除されます。この操作は取り消せません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All saved suggestions will be deleted. This can't be undone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 추천이 모두 삭제돼요. 되돌릴 수 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todas las sugerencias guardadas. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les suggestions enregistrées seront supprimées. Action irréversible."
          }
        }
      }
    },
    "お気に入りに保存したすべての提案を削除します。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
