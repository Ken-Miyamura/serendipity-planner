    "図書館で静かな読書タイム。新しいジャンルの本との出会いを楽しんで。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図書館で静かな読書タイム。新しいジャンルの本との出会いを楽しんで。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet time with a book. A shelf you'd normally walk past might surprise you."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용한 곳에서 책과 보내는 시간. 평소 안 보던 서가도 한번 들러 봐요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rato de calma con un libro. Esa estantería por la que sueles pasar de largo puede sorprenderte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moment calme avec un livre. Ce rayon devant lequel tu passes toujours pourrait te surprendre."
          }
        }
      }
    },
