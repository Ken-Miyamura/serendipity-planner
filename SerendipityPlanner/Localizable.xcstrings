          }
        }
      }
    },
    "積読本を消化するチャンス！静かな場所で本の世界に没頭しましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "積読本を消化するチャンス！静かな場所で本の世界に没頭しましょう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chance at that unread pile. Find somewhere quiet and disappear into it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쌓아 둔 책을 펼칠 기회예요. 조용한 곳에서 푹 빠져 봐요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buena ocasión para esa pila pendiente. Busca un sitio tranquilo y piérdete un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'occasion d'entamer la pile qui attend. Trouve un coin calme et laisse-toi prendre."
          }
        }
      }
    },
    "空き時間が見つかりませんでした。\n忙しい日も、ちょっと深呼吸を。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き時間が見つかりませんでした。\n忙しい日も、ちょっと深呼吸を。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No gaps in today's schedule.\nEven so — take a breath somewhere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 빈 시간이 없네요.\n그래도 한 번쯤 크게 숨 쉬어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no hay huecos en tu agenda.\nAun así, respira hondo un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de creux dans ton programme.\nPense quand même à respirer un coup."
          }
        }
      }
    },
    "空き時間なし": {
