    "軽いジョギングで体と心をリフレッシュ。気持ちのいい汗を流しましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軽いジョギングで体と心をリフレッシュ。気持ちのいい汗を流しましょう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An easy jog clears the head as much as the legs. Work up a decent sweat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가볍게 달리면 다리보다 머리가 먼저 개운해져요. 기분 좋게 땀 흘려 봐요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correr suave despeja la cabeza tanto como las piernas. Suda a gusto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courir doucement éclaircit la tête autant que les jambes. Transpire un bon coup."
          }
        }
      }
    },
    "近くのカフェでひと息": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのカフェでひと息"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pause at a nearby café"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가까운 카페에서 한숨 돌리기"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pausa en un café cercano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pause dans un café du coin"
          }
        }
      }
    },
    "近くのギャラリーでアート鑑賞。新しい視点やインスピレーションが見つかるかも。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのギャラリーでアート鑑賞。新しい視点やインスピレーションが見つかるかも。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop into a gallery nearby. A different way of seeing might follow you out."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가까운 갤러리에 들러 봐요. 다른 시선 하나를 얻어 나올지도 몰라요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra en una galería cercana. A veces sales con otra forma de mirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre dans une galerie du coin. Parfois on en ressort avec un autre regard."
          }
        }
      }
    },
    "近くのジムで体を動かしましょう。運動後の爽快感は格別です。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのジムで体を動かしましょう。運動後の爽快感は格別です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get moving at a gym nearby. Nothing quite matches how you feel afterwards."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가까운 헬스장에서 몸을 움직여요. 끝나고 나면 그 개운함이 남아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévete en un gimnasio cercano. Lo de después no se parece a nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouge dans une salle près de chez toi. Rien ne remplace ce qu'on ressent après."
          }
        }
      }
    },
    "近くのライブハウスやイベントで、生の音楽を体感しましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのライブハウスやイベントで、生の音楽を体感しましょう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a small venue nearby and hear something played in the room."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가까운 공연장에서 직접 연주되는 소리를 들어 봐요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca una sala pequeña por la zona y escucha algo tocado en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve une petite salle dans le coin et écoute quelque chose joué sur place."
          }
        }
      }
    },
    "近くの公園まで散歩して、自然の中でリフレッシュ。深呼吸で心もスッキリ。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くの公園まで散歩して、自然の中でリフレッシュ。深呼吸で心もスッキリ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk to a park nearby and let the green do its work. A few deep breaths go a long way."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가까운 공원까지 걸어가 초록 사이에서 쉬어 가요. 깊게 숨 쉬면 머리도 맑아져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Camina hasta un parque cercano y deja que el verde haga lo suyo. Un par de respiraciones hondas ayudan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marche jusqu'à un parc voisin et laisse le vert faire son effet. Deux respirations profondes suffisent."
          }
        }
      }
    },
