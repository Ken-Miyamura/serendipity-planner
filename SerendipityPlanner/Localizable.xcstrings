    "行き先を選ぶと、その街での小さな偶然をご提案します": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行き先を選ぶと、その街での小さな偶然をご提案します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where you're headed and we'll find small surprises there"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갈 곳을 고르면 그 동네의 작은 우연을 찾아 드려요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinos a dónde vas y buscamos pequeñas sorpresas allí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-nous où tu vas et on cherche de petites surprises là-bas"
          }
        }
      }
    },
    "街を歩きながら、美味しいものを食べ歩き。小さな幸せを見つけましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "街を歩きながら、美味しいものを食べ歩き。小さな幸せを見つけましょう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through a few small places on foot. Little finds, one bite at a time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸으면서 작은 가게 몇 곳을 들러 봐요. 한 입씩 남는 즐거움이 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorre un par de sitios pequeños a pie. Hallazgos chicos, bocado a bocado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enchaîne quelques petites adresses à pied. De petites trouvailles, bouchée après bouchée."
          }
        }
      }
    },
    "街中のパブリックアートやストリートアートを探してみませんか。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "街中のパブリックアートやストリートアートを探してみませんか。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why not go looking for the public art and murals hiding around town?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거리 곳곳에 숨은 공공미술과 벽화를 찾아보는 건 어때요?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Y si sales a buscar los murales y el arte público escondido por la ciudad?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et si tu partais chercher les fresques et l'art public cachés dans la ville ?"
          }
        }
      }
    },
