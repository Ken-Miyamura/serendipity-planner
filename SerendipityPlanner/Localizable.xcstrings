    "%@。お出かけ日和、ショッピングを楽しんで。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。お出かけ日和、ショッピングを楽しんで。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@ — a good day to be out and browse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 나들이하기 좋은 날, 구경하며 걸어 봐요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Buen día para salir a mirar tiendas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Bonne journée pour sortir flâner."
          }
        }
      }
    },
    "%@。お散歩日和です！": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。お散歩日和です！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@ — good weather for a walk."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 산책하기 좋은 날이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Buen día para caminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Le temps idéal pour marcher."
          }
        }
      }
    },
    "%@。アートに触れてみませんか。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。アートに触れてみませんか。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@. Why not see some art?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 예술을 만나 보는 건 어때요?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. ¿Y si ves algo de arte?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Et si tu allais voir de l'art ?"
          }
        }
      }
    },
    "%@。アートに触れてインスピレーションを。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。アートに触れてインスピレーションを。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@ — art might spark something."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 예술에서 영감을 얻어 봐요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. El arte puede encender algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. L'art peut déclencher quelque chose."
          }
        }
      }
    },
    "%@。カフェでほっとひと息つきましょう。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
