      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の近くにあるカフェや公園などを提案するために使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to suggest cafés, parks and other places near you."
          }
        }
