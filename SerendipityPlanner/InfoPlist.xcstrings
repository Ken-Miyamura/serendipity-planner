{
  "sourceLanguage": "ja",
  "version": "1.0",
  "strings": {
    "NSCalendarsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーから空き時間を検出して、体験を提案するために使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to spot gaps in your schedule and suggest things to do."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정에서 빈 시간을 찾아 할 만한 것을 추천하는 데 사용해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para detectar huecos en tu agenda y sugerirte cosas que hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert à repérer les creux dans ton agenda et à te proposer des idées."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーから空き時間を検出して、体験を提案するために使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to spot gaps in your schedule and suggest things to do."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정에서 빈 시간을 찾아 할 만한 것을 추천하는 데 사용해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para detectar huecos en tu agenda y sugerirte cosas que hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert à repérer les creux dans ton agenda et à te proposer des idées."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の近くにあるカフェや公園などを提案するために使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to suggest cafés, parks and other places near you."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처의 카페나 공원 같은 곳을 추천하는 데 사용해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para sugerirte cafeterías, parques y otros sitios cerca de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert à te proposer des cafés, des parcs et d'autres lieux près de toi."
          }
        }
      }
    }
  }
}
